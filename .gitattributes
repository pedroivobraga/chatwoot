# Default: normalize line endings to LF on commit
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Ruby/Rails
*.rb text eol=lf
*.rake text eol=lf
Gemfile text eol=lf
Gemfile.lock text eol=lf

# Web
*.js text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Config
*.env text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Binaries (never convert)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
